---
import ContentPage from '../../components/ContentPage.astro';
import { pages, type Lang } from '../../data/site';

export function getStaticPaths() {
  const visiblePages: Record<Lang, string[]> = {
    ca: ['associacio', 'projectes', 'recursos', 'contacte'],
    en: ['about', 'projects', 'resources', 'contact'],
  };

  return (Object.keys(pages) as Lang[]).flatMap((lang) =>
    Object.entries(pages[lang]).filter(([slug]) => visiblePages[lang].includes(slug)).map(([slug, page]) => ({
      params: { lang, slug },
      props: { lang, slug, page },
    })),
  );
}

const { lang, slug, page } = Astro.props;
---

<ContentPage lang={lang} slug={slug} page={page} />
