---
import { getCollection } from 'astro:content';

// Resource pages were folded into the library list; old links land on the resource's row.
export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map(({ data }) => ({ params: { slug: data.slug } }));
}

const target = `/en/resources/#r-${Astro.params.slug}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <title>UPC Quant Society</title>
  </head>
  <body>
    <a href={target}>{target}</a>
  </body>
</html>
