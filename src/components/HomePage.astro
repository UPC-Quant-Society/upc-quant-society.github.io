---
import BaseLayout from '../layouts/BaseLayout.astro';
import { home, ui, type Lang } from '../data/site';

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const content = home[lang];
const t = ui[lang];
const projectsSlug = lang === 'ca' ? 'projectes' : 'projects';
const aboutSlug = lang === 'ca' ? 'associacio' : 'about';
---

<BaseLayout lang={lang} title={content.title} description={content.description}>
  <section class="home-hero shell">
    <div class="hero-copy">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>{content.heading}</h1>
      <p>{content.intro}</p>
      <div class="hero-links">
        <a class="button button-primary" href={`/${lang}/${projectsSlug}/`}>
          {t.explore}
        </a>
        <a class="button button-secondary" href={`/${lang}/${aboutSlug}/`}>
          {t.learnMore}
        </a>
      </div>
    </div>

    <div class="hero-focus" aria-label={lang === 'ca' ? 'Àrees de treball' : 'Areas of focus'}>
      <p>{lang === 'ca' ? 'ÀREES DE TREBALL' : 'AREAS OF FOCUS'}</p>
      <ul>
        <li>{lang === 'ca' ? 'Matemàtiques aplicades' : 'Applied mathematics'}</li>
        <li>{lang === 'ca' ? 'Programació i dades' : 'Programming and data'}</li>
        <li>{lang === 'ca' ? 'Mercats financers' : 'Financial markets'}</li>
      </ul>
      <span>Barcelona · UPC</span>
    </div>
  </section>

  <section class="phase-section shell">
    <div class="phase-label">{t.currentPhase}</div>
    <div>
      <h2>{t.currentPhaseTitle}</h2>
      <p>{t.currentPhaseText}</p>
    </div>
  </section>

  <section class="home-areas shell">
    {content.areas.map((area) => (
      <a class="area-card" href={area.href}>
        <span>{area.index}</span>
        <h2>{area.title}</h2>
        <p>{area.text}</p>
        <i aria-hidden="true">↗</i>
      </a>
    ))}
  </section>

  <section class="bridge-section shell">
    <div class="bridge-rule"></div>
    <div>
      <p class="eyebrow">{lang === 'ca' ? 'CONNEXIÓ' : 'CONNECTION'}</p>
      <h2>{content.bridgeTitle}</h2>
    </div>
    <div>
      <p>{content.bridgeText}</p>
      <a href={content.bridgeHref}>{content.bridgeLink} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
