---
import BaseLayout from '../layouts/BaseLayout.astro';
import { applicationsOpen, contactEmail, home, membershipFormUrl, partners, type Lang } from '../data/site';

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const content = home[lang];
const [closing, closingLink] = applicationsOpen ? content.applyOpen : content.applyClosed;
const closingHref = applicationsOpen ? membershipFormUrl : `mailto:${contactEmail}`;
---

<BaseLayout lang={lang} title={content.title} description={content.description}>
  <section class="opening">
    <div class="intro">
      <h1>
        {content.heading.map((line) => (
          <span class="line"><span>{line}</span></span>
        ))}
      </h1>
      <p>{content.intro}</p>
    </div>

    <figure class="cone">
      <canvas role="img" aria-label={content.figure.caption} data-cone></canvas>
      <figcaption><span class="fig">Fig. 1.</span> {content.figure.caption}</figcaption>
    </figure>
  </section>

  <section class="practice" aria-labelledby="practice-label">
    <p class="label" id="practice-label">{content.practiceLabel}</p>
    <div class="parts">
      {content.practice.map((part, index) => (
        <article data-reveal style={`--n: ${index}`}>
          <p class="part-label">{part.label}</p>
          <h2>{part.title}</h2>
          <p>{part.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="admissions" aria-labelledby="admissions-label" data-reveal>
    <p class="label" id="admissions-label">{content.admissions}</p>
    <div>
      <h2>{closing}</h2>
      <a href={closingHref} target={applicationsOpen ? '_blank' : undefined} rel={applicationsOpen ? 'noreferrer' : undefined}>
        {closingLink}{!applicationsOpen && <span class="email">{contactEmail}</span>}
      </a>
    </div>
  </section>

  <section class="backers" aria-labelledby="backers-label" data-reveal>
    <p class="label" id="backers-label">{content.partners}</p>
    <ul>
      {partners.map((partner, index) => (
        <li style={`--n: ${index}`}>
          <a href={partner.href} target="_blank" rel="noreferrer">
            {partner.logo ? <img src={partner.logo} alt={partner.name} style={`height: ${partner.height ?? 24}px`} /> : partner.name}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .opening,
  .practice,
  .admissions,
  .backers {
    --grey: #6b6e74;
    --rule: rgba(21, 23, 28, 0.12);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    width: min(1240px, calc(100% - 64px));
    margin: 0 auto;
  }

  /* Opening: who we are, beside a single path finding its way through its own law */
  .opening {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
    min-height: calc(100svh - 64px);
    padding-block: 72px 96px;
  }

  /* The statement: what the figure beside it shows, said in two lines */
  h1 {
    margin: 0 0 36px;
    font-size: clamp(2.5rem, 4.9vw, 4.6rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    text-wrap: balance;
  }

  .line + .line {
    margin-top: 0.12em;
    color: #8b8d92;
  }

  .line > span {
    display: block;
    animation: rise 1.3s var(--ease) 0.15s both;
  }

  .line + .line > span {
    animation-delay: 0.9s;
  }

  .intro p {
    max-width: 32em;
    margin: 0;
    color: #4d5056;
    font-size: 18px;
    font-weight: 300;
    line-height: 1.6;
  }

  .intro p {
    animation: settle 1.4s var(--ease) 1.2s both;
  }

  .cone {
    margin: 0;
    animation: settle 1.4s var(--ease) 0.3s both;
  }

  canvas {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
  }

  figcaption {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    color: var(--grey);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.55;
  }

  .fig {
    color: var(--ink);
    font-weight: 500;
  }

  .label {
    margin: 0;
    color: var(--grey);
    font-size: 15px;
  }

  /* What we do: the four lines of work, side by side */
  .practice {
    padding-block: 40px 120px;
    border-top: 1px solid var(--rule);
  }

  .parts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 56px clamp(32px, 3.5vw, 56px);
    margin-top: 56px;
  }

  .parts article {
    transition-delay: calc(var(--n) * 90ms);
  }

  .part-label {
    margin: 0 0 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--ink);
    font-size: 15px;
    font-weight: 500;
  }

  .parts h2 {
    margin: 0 0 14px;
    font-size: clamp(1.3rem, 1.7vw, 1.55rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .parts p:last-child {
    margin: 0;
    color: #4d5056;
    font-size: 16px;
    font-weight: 300;
  }

  /* Admissions: a statement of its own */
  .admissions {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 96px);
    padding-block: 40px 160px;
    border-top: 1px solid var(--rule);
  }

  .admissions h2 {
    margin: 0 0 28px;
    font-size: clamp(1.9rem, 3.2vw, 2.9rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .admissions a {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0 14px;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: text-underline-offset 0.4s var(--ease);
  }

  .admissions a:hover {
    text-underline-offset: 8px;
  }

  .email {
    color: var(--grey);
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.9;
  }

  /* Backers: one quiet line of logos */
  .backers {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 56px;
    padding-block: 48px 96px;
    border-top: 1px solid var(--rule);
  }

  .backers ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 56px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Logos come in one after another once the line is on screen, and lift a touch on hover. */
  .backers li {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.9s var(--ease), transform 1.1s var(--ease);
    transition-delay: calc(0.25s + var(--n) * 0.14s);
  }

  .backers.is-in li {
    opacity: 1;
    transform: none;
  }

  .backers a {
    display: block;
    color: var(--ink);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.02em;
    transition: transform 0.5s var(--ease);
  }

  .backers img {
    display: block;
    width: auto;
  }

  .backers a:hover {
    transform: translateY(-3px);
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 1s var(--ease), transform 1.2s var(--ease);
  }

  [data-reveal].is-in {
    opacity: 1;
    transform: none;
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (max-width: 1080px) {
    .parts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .opening,
    .admissions {
      grid-template-columns: minmax(0, 1fr);
    }

    .opening {
      min-height: 0;
      padding-block: 48px 72px;
    }

    canvas {
      aspect-ratio: 4 / 3;
    }

    .admissions {
      gap: 24px;
      padding-bottom: 112px;
    }
  }

  @media (max-width: 680px) {
    .opening,
    .practice,
    .admissions,
    .backers {
      width: calc(100% - 32px);
    }

    .intro p {
      font-size: 17px;
    }

    .practice {
      padding-bottom: 88px;
    }

    .parts {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
      margin-top: 40px;
    }

    .parts article {
      transition-delay: 0s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro p,
    .line > span,
    .cone {
      animation: none;
    }

    [data-reveal],
    .backers li {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /*
   * Fig. 1: one Brownian path W_t, drawn slowly against the cone of its law.
   * At time t, W_t ~ N(0, σ²t), so the bands ±σ√t and ±2σ√t hold about 68% and
   * 95% of paths. When a path reaches t = 1 it lingers, fades out and the next
   * one starts; the last few stay behind as faint traces.
   */
  const canvas = document.querySelector<HTMLCanvasElement>('[data-cone]');

  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const INK = '#15171c';
    const GREY = '#8b8d92';
    const ACCENT = '#007bc0';
    const STEPS = 480;
    const RANGE = 2.8; // the plot spans ±2.8σ at t = 1
    const DRAW_SECONDS = 11;
    const HOLD_SECONDS = 1.8;
    const FADE_SECONDS = 1.2;
    const TRACES = 4;

    const randn = () => {
      let u = 0;
      let v = 0;
      while (!u) u = Math.random();
      while (!v) v = Math.random();
      return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
    };

    // Paths that leave the frame are redrawn; that discards under 2% of them.
    const newPath = () => {
      for (;;) {
        const path = new Float32Array(STEPS + 1);
        const dt = Math.sqrt(1 / STEPS);
        let w = 0;
        let inside = true;
        for (let j = 1; j <= STEPS; j++) {
          w += randn() * dt;
          path[j] = w;
          if (Math.abs(w) > RANGE * 0.94) inside = false;
        }
        if (inside) return path;
      }
    };

    const traces: Float32Array[] = [];
    let path = newPath();
    let elapsed = reduceMotion ? DRAW_SECONDS : 0;
    let width = 0;
    let height = 0;

    if (reduceMotion) for (let n = 0; n < TRACES - 1; n++) traces.push(newPath());

    const fit = () => {
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const draw = () => {
      const left = 2;
      const right = width - (width < 520 ? 48 : 60);
      const top = 8;
      const bottom = height - 26;
      const middle = (top + bottom) / 2;
      const xAt = (t: number) => left + t * (right - left);
      const yAt = (v: number) => middle - (v / RANGE) * ((bottom - top) / 2);
      const stroke = (values: Float32Array, upto: number) => {
        const whole = Math.floor(upto);
        ctx.beginPath();
        ctx.moveTo(xAt(0), yAt(0));
        for (let j = 1; j <= whole; j++) ctx.lineTo(xAt(j / STEPS), yAt(values[j]));
        if (upto > whole && whole < STEPS) {
          const v = values[whole] + (values[whole + 1] - values[whole]) * (upto - whole);
          ctx.lineTo(xAt(upto / STEPS), yAt(v));
        }
        ctx.stroke();
      };

      ctx.clearRect(0, 0, width, height);
      ctx.lineWidth = 1;
      ctx.font = `11px ${getComputedStyle(document.body).getPropertyValue('--mono')}`;
      ctx.textBaseline = 'middle';

      ctx.strokeStyle = 'rgba(21, 23, 28, 0.12)';
      ctx.beginPath();
      ctx.moveTo(xAt(0), Math.round(yAt(0)) + 0.5);
      ctx.lineTo(xAt(1), Math.round(yAt(0)) + 0.5);
      ctx.stroke();

      // The cone: ±σ√t and ±2σ√t.
      for (const k of [1, 2]) {
        ctx.strokeStyle = k === 1 ? 'rgba(21, 23, 28, 0.32)' : 'rgba(21, 23, 28, 0.16)';
        for (const sign of [1, -1]) {
          ctx.beginPath();
          for (let n = 0; n <= 120; n++) {
            const t = n / 120;
            const y = yAt(sign * k * Math.sqrt(t));
            if (n === 0) ctx.moveTo(xAt(t), y);
            else ctx.lineTo(xAt(t), y);
          }
          ctx.stroke();
          ctx.fillStyle = GREY;
          ctx.fillText(`${sign > 0 ? '+' : '−'}${k === 1 ? '' : '2'}σ√t`, right + 10, yAt(sign * k));
        }
      }

      ctx.textBaseline = 'top';
      ctx.fillText('t = 0', xAt(0), bottom + 10);
      ctx.textAlign = 'right';
      ctx.fillText('1', xAt(1), bottom + 10);
      ctx.textAlign = 'left';

      ctx.strokeStyle = INK;
      ctx.globalAlpha = 0.14;
      for (const trace of traces) stroke(trace, STEPS);

      const progress = Math.min(1, elapsed / DRAW_SECONDS) * STEPS;
      const fade = 1 - Math.min(1, Math.max(0, (elapsed - DRAW_SECONDS - HOLD_SECONDS) / FADE_SECONDS));
      ctx.globalAlpha = 0.14 + 0.86 * fade;
      ctx.lineWidth = 1.4;
      stroke(path, progress);

      if (fade > 0) {
        const whole = Math.min(STEPS - 1, Math.floor(progress));
        const head = path[whole] + (path[whole + 1] - path[whole]) * (progress - whole);
        ctx.globalAlpha = fade;
        ctx.fillStyle = ACCENT;
        ctx.beginPath();
        ctx.arc(xAt(progress / STEPS), yAt(head), 3, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    };

    fit();
    draw();
    document.fonts?.ready.then(draw);
    new ResizeObserver(() => {
      fit();
      draw();
    }).observe(canvas);

    if (!reduceMotion) {
      // Run only while the figure is on screen and the tab is visible.
      let visible = false;
      let frame = 0;
      let previous = 0;
      const loop = (now: number) => {
        elapsed += previous ? Math.min(0.1, (now - previous) / 1000) : 0;
        previous = now;
        if (elapsed > DRAW_SECONDS + HOLD_SECONDS + FADE_SECONDS) {
          traces.push(path);
          if (traces.length > TRACES) traces.shift();
          path = newPath();
          elapsed = 0;
        }
        draw();
        frame = requestAnimationFrame(loop);
      };
      const sync = () => {
        cancelAnimationFrame(frame);
        previous = 0;
        if (visible && !document.hidden) frame = requestAnimationFrame(loop);
      };
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        sync();
      }).observe(canvas);
      document.addEventListener('visibilitychange', sync);
    }
  }

  const entries = document.querySelectorAll('[data-reveal]');
  if (reduceMotion) {
    entries.forEach((element) => element.classList.add('is-in'));
  } else {
    const reveal = new IntersectionObserver((items) => {
      for (const item of items) {
        if (!item.isIntersecting) continue;
        item.target.classList.add('is-in');
        reveal.unobserve(item.target);
      }
    }, { threshold: 0.2 });
    entries.forEach((element) => reveal.observe(element));
  }
</script>
