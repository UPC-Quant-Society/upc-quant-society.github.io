---
import Logo from './Logo.astro';
import { getAlternatePath, nav, ui, type Lang } from '../data/site';

type Props = {
  lang: Lang;
  slug?: string;
};

const { lang, slug } = Astro.props;
const t = ui[lang];
const alternatePath = getAlternatePath(lang, slug);
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="bar">
    <Logo lang={lang} />
    <nav aria-label={lang === 'ca' ? 'Navegació principal' : 'Main navigation'}>
      {nav[lang].map((item) => (
        <a href={item.href} aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="language" href={alternatePath} hreflang={lang === 'ca' ? 'en' : 'ca'} aria-label={t.languageName}>
        {t.languageShort}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 100;
    top: 0;
    border-bottom: 1px solid rgba(21, 23, 28, 0.1);
    background: rgba(255, 255, 255, 0.94);
  }

  .bar {
    width: min(1480px, calc(100% - 64px));
    height: 64px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  nav a {
    position: relative;
    color: #6b6e74;
    font-size: 16px;
    transition: color 0.3s;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: #15171c;
  }

  nav a[aria-current='page']::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -12px;
    width: 5px;
    height: 5px;
    background: var(--accent);
    transform: translateY(-50%);
  }

  .language {
    padding-left: 24px;
    border-left: 1px solid rgba(21, 23, 28, 0.14);
    font-family: var(--mono);
    font-size: 12px;
  }

  @media (max-width: 680px) {
    .bar {
      width: calc(100% - 32px);
      height: 56px;
    }

    nav {
      gap: 22px;
    }

    nav a {
      font-size: 14px;
    }

    .language {
      padding-left: 16px;
    }
  }

  @media (max-width: 400px) {
    .bar :global(.logo .name) {
      display: none;
    }
  }
</style>
