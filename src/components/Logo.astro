---
type Props = {
  lang: 'ca' | 'en';
};

const { lang } = Astro.props;
---

<a class="logo" href={`/${lang}/`} aria-label="UPC Quant Society">
  <img src="/favicon.svg" width="28" height="28" alt="" />
  <span class="name">UPC Quant Society</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #15171c;
    white-space: nowrap;
  }

  .name {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  img {
    display: block;
    border-radius: 50%;
  }
</style>
