---
type Props = {
  lang: 'ca' | 'en';
};

const { lang } = Astro.props;
---

<a class="logo" href={`/${lang}/`} aria-label="UPC Quant Society">
  <img src="/favicon.svg" width="26" height="26" alt="" />
  <span>UPC Quant Society</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: #15171c;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }

  img {
    display: block;
    border-radius: 50%;
  }
</style>
