---
import { isEssential, topicsOf, type LibraryGroup } from '../../data/library/groups';

type Lang = 'ca' | 'en';

type Props = {
  lang: Lang;
  groups: LibraryGroup[];
};

const { lang, groups } = Astro.props;

function hashString(value: string) {
  let hash = 0;
  for (let index = 0; index < value.length; index += 1) {
    hash = value.charCodeAt(index) + ((hash << 5) - hash);
  }
  return Math.abs(hash);
}

// Topics start on a circle and each resource near its primary topic; ForceAtlas2 settles the rest.
const topicPositions = new Map(
  groups.map((group, index) => {
    const angle = (index / groups.length) * Math.PI * 2;
    return [group.id, { x: Math.cos(angle) * 10, y: Math.sin(angle) * 10 }];
  }),
);

const topicNodes = groups.map((group) => ({
  id: `topic:${group.id}`,
  label: group.name,
  ...topicPositions.get(group.id)!,
  size: 9,
  nodeType: 'topic',
  target: `topic-${group.id}`,
}));

const resources = groups.flatMap((group) => group.resources);

const resourceNodes = resources.map((resource) => {
  const origin = topicPositions.get(topicsOf(resource)[0]) ?? { x: 0, y: 0 };
  const hash = hashString(resource.slug);
  const angle = ((hash % 360) * Math.PI) / 180;
  const distance = 1.5 + (hash % 40) / 20;
  return {
    id: `resource:${resource.slug}`,
    label: resource.title,
    x: origin.x + Math.cos(angle) * distance,
    y: origin.y + Math.sin(angle) * distance,
    size: isEssential(resource) ? 5 : 3.5,
    nodeType: isEssential(resource) ? 'essential' : 'resource',
    target: `r-${resource.slug}`,
  };
});

const edges = resources.flatMap((resource) =>
  topicsOf(resource)
    .filter((topic) => topicPositions.has(topic))
    .map((topic) => ({ source: `topic:${topic}`, target: `resource:${resource.slug}` })),
);

const serializedGraphData = JSON.stringify({ nodes: [...topicNodes, ...resourceNodes], edges }).replace(/</g, '\\u003c');

const t = {
  ca: { reset: 'Restableix la vista', topic: 'Tema', resource: 'Recurs', essential: 'Essencial', hint: 'Fes clic en un node per anar-hi a la llista.' },
  en: { reset: 'Reset view', topic: 'Topic', resource: 'Resource', essential: 'Essential', hint: 'Click a node to find it in the list.' },
}[lang];
---

<div class="knowledge-graph" data-knowledge-graph>
  <div class="canvas" data-graph-canvas></div>
  <div class="caption">
    <span class="legend">
      <span><i class="topic"></i>{t.topic}</span>
      <span><i class="essential"></i>{t.essential}</span>
      <span><i class="resource"></i>{t.resource}</span>
    </span>
    <span>{t.hint}</span>
    <button type="button" data-graph-reset>{t.reset}</button>
  </div>
  <script type="application/json" data-graph-data set:html={serializedGraphData} />
</div>

<script>
  import Graph from 'graphology';
  import Sigma from 'sigma';
  import forceAtlas2 from 'graphology-layout-forceatlas2';

  type GraphNode = {
    id: string;
    label: string;
    x: number;
    y: number;
    size: number;
    nodeType: 'topic' | 'essential' | 'resource';
    target: string;
  };

  type GraphData = {
    nodes: GraphNode[];
    edges: { source: string; target: string }[];
  };

  const PALETTE = {
    topic: '#15171c',
    essential: '#15171c',
    resource: '#a3a5aa',
    edge: '#e1e1df',
    muted: '#e6e6e4',
    match: '#15171c',
  };

  const widget = document.querySelector<HTMLElement>('[data-knowledge-graph]');
  const canvas = widget?.querySelector<HTMLElement>('[data-graph-canvas]');
  const dataElement = widget?.querySelector<HTMLScriptElement>('[data-graph-data]');
  let filter = { query: '', essentialOnly: false };
  let renderer: Sigma | undefined;

  // Sigma needs a sized container, so the graph is built the first time the map is shown.
  const init = () => {
    if (!widget || !canvas || !dataElement) return;
    if (renderer) {
      renderer.resize();
      renderer.refresh();
      return;
    }

    const data = JSON.parse(dataElement.textContent ?? '{}') as GraphData;
    const graph = new Graph({ type: 'undirected' });
    data.nodes.forEach((node) => graph.addNode(node.id, { ...node, color: PALETTE[node.nodeType] }));
    data.edges.forEach((edge) => {
      if (graph.hasNode(edge.source) && graph.hasNode(edge.target)) {
        graph.mergeEdge(edge.source, edge.target, { size: 1, color: PALETTE.edge });
      }
    });

    forceAtlas2.assign(graph, {
      iterations: 200,
      settings: { gravity: 1.4, scalingRatio: 4, slowDown: 2, adjustSizes: true },
    });

    const matches = (node: string) => {
      const attributes = graph.getNodeAttributes(node);
      if (attributes.nodeType === 'topic') return !filter.query && !filter.essentialOnly;
      if (filter.essentialOnly && attributes.nodeType !== 'essential') return false;
      return !filter.query || String(attributes.label).toLowerCase().includes(filter.query);
    };
    const filtering = () => Boolean(filter.query || filter.essentialOnly);

    renderer = new Sigma(graph, canvas, {
      labelFont: '"Instrument Sans", sans-serif',
      labelSize: 13,
      labelWeight: '500',
      labelColor: { color: '#15171c' },
      labelRenderedSizeThreshold: 6,
      zIndex: true,
      nodeReducer(node, attributes) {
        if (!filtering()) {
          return attributes.nodeType === 'topic' ? { ...attributes, forceLabel: true } : attributes;
        }
        return matches(node)
          ? { ...attributes, color: PALETTE.match, size: attributes.size * 1.4, zIndex: 2, forceLabel: true }
          : { ...attributes, color: PALETTE.muted, label: '', zIndex: 0 };
      },
      edgeReducer(edge, attributes) {
        if (!filtering()) return attributes;
        const [source, target] = graph.extremities(edge);
        return { ...attributes, hidden: !matches(source) && !matches(target) };
      },
    });

    renderer.on('enterNode', () => (canvas.style.cursor = 'pointer'));
    renderer.on('leaveNode', () => (canvas.style.cursor = 'grab'));
    renderer.on('clickNode', ({ node }) => {
      window.dispatchEvent(new CustomEvent('library:focus', { detail: graph.getNodeAttribute(node, 'target') }));
    });

    widget.querySelector('[data-graph-reset]')?.addEventListener('click', () => {
      renderer?.getCamera().animatedReset({ duration: 500 });
    });
  };

  window.addEventListener('library:map-shown', init);
  window.addEventListener('library:filter', (event) => {
    filter = (event as CustomEvent<typeof filter>).detail;
    renderer?.refresh();
  });
</script>

<style>
  .knowledge-graph {
    border-bottom: 1px solid rgba(21, 23, 28, 0.1);
  }

  .canvas {
    width: 100%;
    height: min(72svh, 720px);
    min-height: 480px;
    cursor: grab;
  }

  .canvas:active {
    cursor: grabbing;
  }

  .caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding: 16px 0;
    border-top: 1px solid rgba(21, 23, 28, 0.1);
    color: #8b8d92;
    font-family: var(--mono);
    font-size: 12px;
  }

  .legend {
    display: flex;
    gap: 20px;
  }

  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .legend i {
    display: inline-block;
    border-radius: 50%;
  }

  .topic {
    width: 9px;
    height: 9px;
    background: #15171c;
  }

  .essential {
    width: 6px;
    height: 6px;
    background: #15171c;
  }

  .resource {
    width: 6px;
    height: 6px;
    background: #a3a5aa;
  }

  button {
    padding: 0;
    border: 0;
    background: none;
    color: #15171c;
    font: inherit;
    cursor: pointer;
  }

  button:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
